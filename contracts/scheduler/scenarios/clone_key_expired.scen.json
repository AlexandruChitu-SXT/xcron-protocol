{
    "name": "clone-key-expired",
    "comment": "Test that an expired Clone-Key cannot schedule tasks",
    "steps": [
        {
            "step": "setState",
            "accounts": {
                "address:owner": {
                    "nonce": "0",
                    "balance": "100,000,000,000,000,000,000"
                },
                "address:user1": {
                    "nonce": "0",
                    "balance": "10,000,000,000,000,000,000"
                },
                "address:clone1": {
                    "nonce": "0",
                    "balance": "0"
                },
                "address:keeper_registry": {
                    "nonce": "0",
                    "balance": "0",
                    "code": ""
                },
                "address:rewards": {
                    "nonce": "0",
                    "balance": "0",
                    "code": ""
                },
                "address:target_contract": {
                    "nonce": "0",
                    "balance": "0",
                    "code": ""
                }
            },
            "newAddresses": [
                {
                    "creatorAddress": "address:owner",
                    "creatorNonce": "0",
                    "newAddress": "sc:scheduler"
                }
            ],
            "currentBlockInfo": {
                "blockTimestamp": "1000",
                "blockRound": "100"
            }
        },
        {
            "step": "scDeploy",
            "id": "deploy",
            "tx": {
                "from": "address:owner",
                "contractCode": "mxsc:../output/scheduler.mxsc.json",
                "arguments": [
                    "address:keeper_registry",
                    "address:rewards",
                    "100,000,000,000,000,000",
                    "500"
                ],
                "gasLimit": "50,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "0"
            }
        },
        {
            "step": "scCall",
            "id": "authorize-clone-key-short-ttl",
            "comment": "User1 authorizes clone1 with 1 hour TTL at timestamp 1000 → expires at 4600",
            "tx": {
                "from": "address:user1",
                "to": "sc:scheduler",
                "function": "authorizeCloneKey",
                "arguments": [
                    "address:clone1",
                    "3600"
                ],
                "egldValue": "500,000,000,000,000,000",
                "gasLimit": "10,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "0"
            }
        },
        {
            "step": "setState",
            "comment": "Fast-forward time past expiry (5000 > 4600)",
            "currentBlockInfo": {
                "blockTimestamp": "5000",
                "blockRound": "200"
            }
        },
        {
            "step": "scCall",
            "id": "clone-schedules-after-expiry",
            "comment": "Expired Clone-Key tries to schedule — resolve_caller returns (clone1, false), treated as regular caller. Since clone1 has 0 EGLD and sends no payment, deposit check fails",
            "tx": {
                "from": "address:clone1",
                "to": "sc:scheduler",
                "function": "scheduleTask",
                "arguments": [
                    "address:target_contract",
                    "str:myFunction",
                    "0x00000000",
                    "0x0000000000000013ba",
                    "10,000,000",
                    "3",
                    "1000"
                ],
                "egldValue": "0",
                "gasLimit": "20,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "4",
                "message": "str:Deposit below minimum"
            }
        }
    ]
}