            "comment": "Keeper1 executes CRIB task with correct secret",
            "tx": {
                "from": "address:keeper1",
                "to": "sc:scheduler",
                "function": "executeQuantumTask",
                "arguments": [
                    "",
                    "0x0101010101010101010101010101010101010101010101010101010101010101"
                ],
                "gasLimit": "50,000,000",
                "gasPrice": "0"
            },
            "expect": {
