# ═══════════════════════════════════════════════════
#  XCron Protocol — Environment Configuration
# ═══════════════════════════════════════════════════
# Copy this file to .env and fill in your values

# Network: "devnet", "testnet", or "mainnet"
VITE_NETWORK=devnet

# WalletConnect Project ID (get yours at https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Contract Addresses (optional — defaults are built-in for devnet/testnet)
# VITE_SCHEDULER_ADDRESS=erd1...
# VITE_KEEPER_REGISTRY_ADDRESS=erd1...
# VITE_REWARDS_ADDRESS=erd1...
# VITE_PING_ADDRESS=erd1...

# Gemini API Key for XCron AI chat (server-side only, NO VITE_ prefix)
# Get yours at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_api_key_here
