{
    "name": "clone-key-revoke",
    "comment": "Test revoking a Clone-Key and getting unspent balance refunded",
    "steps": [
        {
            "step": "setState",
            "accounts": {
                "address:owner": {
                    "nonce": "0",
                    "balance": "100,000,000,000,000,000,000"
                },
                "address:user1": {
                    "nonce": "0",
                    "balance": "10,000,000,000,000,000,000"
                },
                "address:clone1": {
                    "nonce": "0",
                    "balance": "0"
                },
                "address:keeper_registry": {
                    "nonce": "0",
                    "balance": "0",
                    "code": ""
                },
                "address:rewards": {
                    "nonce": "0",
                    "balance": "0",
                    "code": ""
                }
            },
            "newAddresses": [
                {
                    "creatorAddress": "address:owner",
                    "creatorNonce": "0",
                    "newAddress": "sc:scheduler"
                }
            ],
            "currentBlockInfo": {
                "blockTimestamp": "1000",
                "blockRound": "100"
            }
        },
        {
            "step": "scDeploy",
            "id": "deploy",
            "tx": {
                "from": "address:owner",
                "contractCode": "mxsc:output/scheduler.mxsc.json",
                "arguments": [
                    "address:keeper_registry",
                    "address:rewards",
                    "100,000,000,000,000,000",
                    "500"
                ],
                "gasLimit": "50,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "0"
            }
        },
        {
            "step": "scCall",
            "id": "authorize-clone-key",
            "comment": "User1 authorizes clone1 with 1 EGLD spend limit, 1 day TTL",
            "tx": {
                "from": "address:user1",
                "to": "sc:scheduler",
                "function": "authorizeCloneKey",
                "arguments": [
                    "address:clone1",
                    "86400"
                ],
                "egldValue": "1,000,000,000,000,000,000",
                "gasLimit": "10,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "0"
            }
        },
        {
            "step": "scCall",
            "id": "revoke-clone-key",
            "comment": "User1 revokes clone1 — should get full 1 EGLD refund (nothing was spent)",
            "tx": {
                "from": "address:user1",
                "to": "sc:scheduler",
                "function": "revokeCloneKey",
                "arguments": [
                    "address:clone1"
                ],
                "gasLimit": "10,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "0"
            }
        },
        {
            "step": "checkState",
            "comment": "Verify user1 got the 1 EGLD refund (balance back to 10 EGLD)",
            "accounts": {
                "address:user1": {
                    "nonce": "*",
                    "balance": "10,000,000,000,000,000,000"
                }
            }
        }
    ]
}