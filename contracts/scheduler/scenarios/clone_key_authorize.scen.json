{
    "name": "clone-key-authorize",
    "comment": "Test authorizing a Clone-Key and verifying balance transfer",
    "steps": [
        {
            "step": "setState",
            "accounts": {
                "address:owner": {
                    "nonce": "0",
                    "balance": "100,000,000,000,000,000,000"
                },
                "address:user1": {
                    "nonce": "0",
                    "balance": "10,000,000,000,000,000,000"
                },
                "address:clone1": {
                    "nonce": "0",
                    "balance": "0"
                },
                "address:keeper_registry": {
                    "nonce": "0",
                    "balance": "0",
                    "code": ""
                },
                "address:rewards": {
                    "nonce": "0",
                    "balance": "0",
                    "code": ""
                }
            },
            "newAddresses": [
                {
                    "creatorAddress": "address:owner",
                    "creatorNonce": "0",
                    "newAddress": "sc:scheduler"
                }
            ],
            "currentBlockInfo": {
                "blockTimestamp": "1000",
                "blockRound": "100"
            }
        },
        {
            "step": "scDeploy",
            "id": "deploy",
            "tx": {
                "from": "address:owner",
                "contractCode": "mxsc:output/scheduler.mxsc.json",
                "arguments": [
                    "address:keeper_registry",
                    "address:rewards",
                    "100,000,000,000,000,000",
                    "500"
                ],
                "gasLimit": "50,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "0"
            }
        },
        {
            "step": "scCall",
            "id": "authorize-clone-key",
            "comment": "User1 authorizes clone1 with 0.5 EGLD spend limit, 1 day TTL",
            "tx": {
                "from": "address:user1",
                "to": "sc:scheduler",
                "function": "authorizeCloneKey",
                "arguments": [
                    "address:clone1",
                    "86400"
                ],
                "egldValue": "500,000,000,000,000,000",
                "gasLimit": "10,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "0"
            }
        },
        {
            "step": "scQuery",
            "id": "verify-clone-key-exists",
            "comment": "Verify Clone-Key info is retrievable (any non-empty output = exists)",
            "tx": {
                "to": "sc:scheduler",
                "function": "getCloneKeyInfo",
                "arguments": [
                    "address:clone1"
                ]
            },
            "expect": {
                "out": [
                    "*"
                ],
                "status": "0"
            }
        },
        {
            "step": "checkState",
            "comment": "Verify 0.5 EGLD was transferred from user1 to the scheduler contract",
            "accounts": {
                "address:user1": {
                    "nonce": "*",
                    "balance": "9,500,000,000,000,000,000"
                }
            }
        }
    ]
}