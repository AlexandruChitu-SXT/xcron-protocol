{
    "name": "execute-not-ripe",
    "comment": "Verify that a keeper cannot execute a task before its target round",
    "steps": [
        {
            "step": "setState",
            "accounts": {
                "address:owner": {
                    "nonce": "0",
                    "balance": "100,000,000,000,000,000,000"
                },
                "address:user1": {
                    "nonce": "0",
                    "balance": "50,000,000,000,000,000,000"
                },
                "address:keeper1": {
                    "nonce": "0",
                    "balance": "10,000,000,000,000,000,000"
                },
                "address:keeper_registry": {
                    "nonce": "0",
                    "balance": "0",
                    "code": ""
                },
                "address:rewards": {
                    "nonce": "0",
                    "balance": "0",
                    "code": ""
                },
                "address:target_contract": {
                    "nonce": "0",
                    "balance": "0",
                    "code": ""
                }
            },
            "newAddresses": [
                {
                    "creatorAddress": "address:owner",
                    "creatorNonce": "0",
                    "newAddress": "sc:scheduler"
                }
            ],
            "currentBlockInfo": {
                "blockRound": "100"
            }
        },
        {
            "step": "scDeploy",
            "id": "deploy",
            "tx": {
                "from": "address:owner",
                "contractCode": "mxsc:../output/scheduler.mxsc.json",
                "arguments": [
                    "address:keeper_registry",
                    "address:rewards",
                    "100,000,000,000,000,000",
                    "500"
                ],
                "gasLimit": "50,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "0"
            }
        },
        {
            "step": "scCall",
            "id": "add-keeper",
            "tx": {
                "from": "address:owner",
                "to": "sc:scheduler",
                "function": "addWhitelistedKeeper",
                "arguments": [
                    "address:keeper1"
                ],
                "gasLimit": "10,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "0"
            }
        },
        {
            "step": "scCall",
            "id": "schedule-future-task",
            "comment": "Schedule task for round 500 (current is 100)",
            "tx": {
                "from": "address:user1",
                "to": "sc:scheduler",
                "function": "scheduleTask",
                "arguments": [
                    "address:target_contract",
                    "str:ping",
                    "0x00000000",
                    "0x0000000000000001f4",
                    "10,000,000",
                    "3",
                    "1000",
                    ""
                ],
                "egldValue": "1,000,000,000,000,000,000",
                "gasLimit": "20,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [
                    "1"
                ],
                "status": "0"
            }
        },
        {
            "step": "setState",
            "comment": "Advance to round 150 — still before target round 500",
            "currentBlockInfo": {
                "blockRound": "150"
            }
        },
        {
            "step": "scCall",
            "id": "execute-too-early",
            "comment": "Keeper tries to execute before target round — should fail",
            "tx": {
                "from": "address:keeper1",
                "to": "sc:scheduler",
                "function": "executeTask",
                "arguments": [
                    "1"
                ],
                "gasLimit": "30,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "4",
                "message": "str:Task not yet ripe"
            }
        }
    ]
}