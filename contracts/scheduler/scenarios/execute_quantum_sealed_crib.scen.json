{
    "name": "execute-quantum-sealed-crib",
    "comment": "Test execution of Quantum Sealed CRIB task",
    "steps": [
        {
            "step": "setState",
            "accounts": {
                "address:owner": {
                    "nonce": "0",
                    "balance": "100,000,000,000,000,000,000"
                },
                "address:user1": {
                    "nonce": "0",
                    "balance": "50,000,000,000,000,000,000"
                },
                "address:keeper1": {
                    "nonce": "0",
                    "balance": "10,000,000,000,000,000,000"
