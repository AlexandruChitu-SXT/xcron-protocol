# ═══════════════════════════════════════════════════════════
#  xCron Protocol — .gitignore
# ═══════════════════════════════════════════════════════════

# ──────── SECURITY: PRIVATE KEYS & WALLETS ────────
.secrets/
wallets/
*.pem
*.keystore.json

# ──────── RUST / SMART CONTRACTS ────────
contracts/target/
contracts/output/
**/wasm/target/
wasm/
output/

# ──────── NODE.JS ────────
node_modules/
dist/
.cache/

# ──────── PYTHON ────────
.venv/
__pycache__/
*.pyc

# ──────── IDE & OS ────────
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# ──────── ENVIRONMENT & SECRETS ────────
.env
.env.local
.env.*.local

# ──────── PERSONAL DATA / GRANT DOCUMENTS ────────
*.pdf
xcron/*.pdf
xcron/*.metadata.json

# ──────── KEEPER BOT SECRETS & LOGS ────────
keeper/keeper-config.json
keeper/keeper-logs/
keeper-logs/

# ──────── BUILD ARTIFACTS ────────
*.mxsc.json
contracts/*/scenarios/output/

# ──────── MISC ────────
*.log
mx-ai-skills
*.resolved
*.resolved.*
*.metadata.json
.deployed_addresses.json
.agent/

# ──────── WASM BUILD ARTIFACTS ────────
*/target/
contracts/*/target/
contracts/*/wasm/target/

# ──────── LOCAL RUNNERS ────────
start.sh
