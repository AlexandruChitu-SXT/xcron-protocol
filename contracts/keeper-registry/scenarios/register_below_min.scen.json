{
    "name": "register-below-min-stake",
    "comment": "Test that registering with stake below min_stake fails",
    "steps": [
        {
            "step": "setState",
            "accounts": {
                "address:owner": {
                    "nonce": "0",
                    "balance": "100,000,000,000,000,000,000"
                },
                "address:keeper1": {
                    "nonce": "0",
                    "balance": "10,000,000,000,000,000,000"
                },
                "address:treasury": {
                    "nonce": "0",
                    "balance": "0"
                }
            },
            "newAddresses": [
                {
                    "creatorAddress": "address:owner",
                    "creatorNonce": "0",
                    "newAddress": "sc:keeper_registry"
                }
            ]
        },
        {
            "step": "scDeploy",
            "id": "deploy",
            "tx": {
                "from": "address:owner",
                "contractCode": "mxsc:output/keeper-registry.mxsc.json",
                "arguments": [
                    "1,000,000,000,000,000,000",
                    "1000",
                    "600",
                    "address:treasury"
                ],
                "gasLimit": "50,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "0"
            }
        },
        {
            "step": "scCall",
            "id": "register-below-min",
            "comment": "Try to register with 0.1 EGLD (min is 1 EGLD) — should fail",
            "tx": {
                "from": "address:keeper1",
                "to": "sc:keeper_registry",
                "function": "registerKeeper",
                "arguments": [],
                "value": "100,000,000,000,000,000",
                "gasLimit": "20,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "4",
                "message": "str:Stake below minimum"
            }
        }
    ]
}