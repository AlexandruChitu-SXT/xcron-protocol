{
    "name": "add-stake",
    "comment": "Test adding more stake to an existing keeper registration",
    "steps": [
        {
            "step": "setState",
            "accounts": {
                "address:owner": {
                    "nonce": "0",
                    "balance": "100,000,000,000,000,000,000"
                },
                "address:keeper1": {
                    "nonce": "0",
                    "balance": "20,000,000,000,000,000,000"
                },
                "address:treasury": {
                    "nonce": "0",
                    "balance": "0"
                }
            },
            "newAddresses": [
                {
                    "creatorAddress": "address:owner",
                    "creatorNonce": "0",
                    "newAddress": "sc:keeper_registry"
                }
            ]
        },
        {
            "step": "scDeploy",
            "id": "deploy",
            "tx": {
                "from": "address:owner",
                "contractCode": "file:../output/keeper-registry.mxsc.json",
                "arguments": [
                    "1,000,000,000,000,000,000",
                    "1000",
                    "600",
                    "address:treasury"
                ],
                "gasLimit": "50,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "0"
            }
        },
        {
            "step": "scCall",
            "id": "register",
            "tx": {
                "from": "address:keeper1",
                "to": "sc:keeper_registry",
                "function": "registerKeeper",
                "arguments": [],
                "value": "5,000,000,000,000,000,000",
                "gasLimit": "20,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "0"
            }
        },
        {
            "step": "scQuery",
            "id": "check-initial-stake",
            "comment": "Verify initial stake is 5 EGLD",
            "tx": {
                "to": "sc:keeper_registry",
                "function": "getKeeperStake",
                "arguments": [
                    "address:keeper1"
                ]
            },
            "expect": {
                "out": [
                    "5,000,000,000,000,000,000"
                ],
                "status": "0"
            }
        },
        {
            "step": "scCall",
            "id": "add-stake",
            "comment": "Add 3 more EGLD",
            "tx": {
                "from": "address:keeper1",
                "to": "sc:keeper_registry",
                "function": "addStake",
                "arguments": [],
                "value": "3,000,000,000,000,000,000",
                "gasLimit": "10,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "0"
            }
        },
        {
            "step": "scQuery",
            "id": "check-updated-stake",
            "comment": "Verify total stake is now 8 EGLD",
            "tx": {
                "to": "sc:keeper_registry",
                "function": "getKeeperStake",
                "arguments": [
                    "address:keeper1"
                ]
            },
            "expect": {
                "out": [
                    "8,000,000,000,000,000,000"
                ],
                "status": "0"
            }
        }
    ]
}