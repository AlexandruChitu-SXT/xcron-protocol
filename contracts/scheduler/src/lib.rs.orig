//! XCron Scheduler Contract
//!
//! Core contract of the XCron protocol. Manages the full lifecycle of
//! automation tasks: scheduling, validation, execution dispatch (via async
//! callbacks), commit-reveal anti-MEV protection, and stuck task recovery.
//!
//! # Architecture
//!
//! Following MultiversX best practices, `lib.rs` contains ONLY `init` and
//! `upgrade`. All logic is split into dedicated modules:
//!
//! - [`scheduling`] — Task creation, cancellation, metadata
//! - [`execution`] — Task execution, async callbacks, recovery, expiration
//! - [`commit_reveal`] — Anti-MEV commit-reveal protocol
//! - [`admin`] — Blacklisting, deposit caps, security views
//! - [`config`] — Owner configuration endpoints
//! - [`storage`] — Storage mapper declarations
//! - [`events`] — Event definitions
//! - [`helpers`] — Internal calculation and indexing helpers
//! - [`validation`] — S-1 to S-13 security validations
//! - [`views`] — Read-only query endpoints

#![no_std]

multiversx_sc::imports!();

pub mod admin;
pub mod clone_keys;
pub mod commit_reveal;
pub mod config;
pub mod events;
pub mod execution;
pub mod helpers;
pub mod proxy;
pub mod scheduling;
pub mod storage;
pub mod validation;
pub mod views;

#[multiversx_sc::contract]
pub trait SchedulerContract:
    storage::StorageModule
    + events::EventsModule
    + views::ViewsModule
    + config::ConfigModule
    + validation::ValidationModule
    + helpers::HelpersModule
    + scheduling::SchedulingModule
    + execution::ExecutionModule
    + commit_reveal::CommitRevealModule
    + clone_keys::CloneKeysModule
    + admin::AdminModule
    + common::pausable::PausableModule
{
    /// Initialize the Scheduler with protocol parameters.
    #[init]
    fn init(
        &self,
        keeper_registry: ManagedAddress,
        rewards_addr: ManagedAddress,
        min_deposit: BigUint,
        protocol_fee_bps: u64,
    ) {
        self.keeper_registry_addr().set(&keeper_registry);
        self.rewards_addr().set(&rewards_addr);
        self.min_deposit().set(&min_deposit);
        self.protocol_fee_bps().set(protocol_fee_bps);
        self.reveal_window()
            .set(common::constants::DEFAULT_REVEAL_WINDOW_SECONDS);
        self.commit_bond().set(BigUint::zero());
        self.task_nonce().set(0u64);
        self.paused().set(false);
        self.executing_guard().set(false);
        self.version().set(1u32);
        self.max_reward_per_exec().set(BigUint::from(
            common::constants::DEFAULT_MAX_REWARD_PER_EXEC,
        ));
        self.max_tasks_per_round()
            .set(common::constants::MAX_TASKS_PER_ROUND);
    }

    /// Safe upgrade — preserves storage, bumps version, initializes new mappers.
    ///
    /// Uses `set_if_empty` for any mappers added after initial deployment to
    /// avoid overwriting existing values. This follows MultiversX upgrade guidelines.
    #[upgrade]
    fn upgrade(&self) {
        self.version().update(|v| *v += 1);

        // Gap 5 fix: Initialize mappers that may not exist on older deployments.
        // set_if_empty ensures values are only set on first upgrade that adds them.
        self.max_tasks_per_round()
            .set_if_empty(common::constants::MAX_TASKS_PER_ROUND);
        self.max_reward_per_exec().set_if_empty(BigUint::from(
            common::constants::DEFAULT_MAX_REWARD_PER_EXEC,
        ));
        self.reveal_window()
            .set_if_empty(common::constants::DEFAULT_REVEAL_WINDOW_SECONDS);
        self.accrued_protocol_fees().set_if_empty(BigUint::zero());
    }
}
