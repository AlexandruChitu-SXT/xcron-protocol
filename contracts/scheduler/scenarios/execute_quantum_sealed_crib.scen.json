        {
            "step": "scCall",
            "id": "schedule-task",
            "comment": "User1 schedules a CRIB task via modern path",
            "tx": {
                "from": "address:user1",
                "to": "sc:scheduler",
                "function": "scheduleQuantumTask",
                "arguments": [
                    ""
                ],
                "egldValue": "1,000,000,000,000,000,000",
                "gasLimit": "20,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [
                    "0xc8ebb002a7ab6c21528f3c3e9d6e47dc0a57ad91ced35f280d1a5b159b48b84b"
                ],
                "status": "0"
