{
    "name": "dynamic-gas-calculation",
    "comment": "Test that cross-shard gas overhead is calculated correctly: 0% intra, 15% keeper-affinity, 30% full cross",
    "steps": [
        {
            "step": "setState",
            "accounts": {
                "address:owner": {
                    "nonce": "0",
                    "balance": "100,000,000,000,000,000,000",
                    "storage": {}
                },
                "address:user1": {
                    "nonce": "0",
                    "balance": "50,000,000,000,000,000,000",
                    "storage": {}
                },
                "address:keeper1": {
                    "nonce": "0",
                    "balance": "50,000,000,000,000,000,000",
                    "storage": {}
                },
                "sc:target_contract": {
                    "nonce": "0",
                    "balance": "0",
                    "code": "file:../demo/output/demo.wasm",
                    "storage": {}
                }
            },
            "newAddresses": [
                {
                    "creatorAddress": "address:owner",
                    "creatorNonce": "0",
                    "newAddress": "sc:scheduler"
                }
            ]
        },
        {
            "step": "scDeploy",
            "id": "deploy",
            "comment": "Deploy Scheduler",
            "tx": {
                "from": "address:owner",
                "contractCode": "mxsc:../output/scheduler.mxsc.json",
                "arguments": [
                    "address:keeper_registry",
                    "address:rewards",
                    "100,000,000,000,000,000",
                    "500"
                ],
                "gasLimit": "50,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "0"
            }
        },
        {
            "step": "scCall",
            "id": "whitelist-keeper",
            "tx": {
                "from": "address:owner",
                "to": "sc:scheduler",
                "function": "addWhitelistedKeeper",
                "arguments": [
                    "address:keeper1"
                ],
                "gasLimit": "5,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "status": "0"
            }
        },
        {
            "step": "scCall",
            "id": "schedule-task",
            "comment": "Schedule task with 10M gas — execution should factor in cross-shard overhead",
            "tx": {
                "from": "address:user1",
                "to": "sc:scheduler",
                "egldValue": "1,000,000,000,000,000,000",
                "function": "scheduleTask",
                "arguments": [
                    "sc:target_contract",
                    "str:ping",
                    "",
                    "u8:0|u64:0",
                    "10,000,000",
                    "0",
                    "3600"
                ],
                "gasLimit": "20,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [
                    "1"
                ],
                "status": "0"
            }
        },
        {
            "step": "scCall",
            "id": "execute-with-insufficient-gas",
            "comment": "Execute with too little gas — should fail with 'Insufficient gas' since we need task_gas + overhead + callback + safety margin",
            "tx": {
                "from": "address:keeper1",
                "to": "sc:scheduler",
                "function": "executeTask",
                "arguments": [
                    "1"
                ],
                "gasLimit": "15,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "status": "4",
                "message": "str:Insufficient gas for full execution"
            }
        }
    ]
}