{
    "name": "dangerous-endpoint-blocked",
    "comment": "S-1b: Verify that dangerous endpoints (upgradeContract, setOwner, ESDTTransfer) are blocked",
    "steps": [
        {
            "step": "setState",
            "accounts": {
                "address:owner": {
                    "nonce": "0",
                    "balance": "100,000,000,000,000,000,000"
                },
                "address:user1": {
                    "nonce": "0",
                    "balance": "50,000,000,000,000,000,000"
                },
                "address:target": {
                    "nonce": "0",
                    "balance": "0",
                    "code": ""
                },
                "address:keeper_registry": {
                    "nonce": "0",
                    "balance": "0",
                    "code": ""
                },
                "address:rewards": {
                    "nonce": "0",
                    "balance": "0",
                    "code": ""
                }
            },
            "newAddresses": [
                {
                    "creatorAddress": "address:owner",
                    "creatorNonce": "0",
                    "newAddress": "sc:scheduler"
                }
            ]
        },
        {
            "step": "scDeploy",
            "id": "deploy",
            "tx": {
                "from": "address:owner",
                "contractCode": "mxsc:../output/scheduler.mxsc.json",
                "arguments": [
                    "address:keeper_registry",
                    "address:rewards",
                    "100,000,000,000,000,000",
                    "500"
                ],
                "gasLimit": "50,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "0"
            }
        },
        {
            "step": "scCall",
            "id": "block-upgradeContract",
            "comment": "S-1b: upgradeContract is a dangerous endpoint — must be blocked",
            "tx": {
                "from": "address:user1",
                "to": "sc:scheduler",
                "function": "scheduleTask",
                "arguments": [
                    "address:target",
                    "str:upgradeContract",
                    "0x00000000",
                    "0x0000000000000000c8",
                    "10,000,000",
                    "3",
                    "1000",
                    ""
                ],
                "egldValue": "1,000,000,000,000,000,000",
                "gasLimit": "20,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "4",
                "message": "str:S-1: Dangerous endpoint blocked"
            }
        },
        {
            "step": "scCall",
            "id": "block-ESDTTransfer",
            "comment": "S-1b: ESDTTransfer is a dangerous endpoint — must be blocked",
            "tx": {
                "from": "address:user1",
                "to": "sc:scheduler",
                "function": "scheduleTask",
                "arguments": [
                    "address:target",
                    "str:ESDTTransfer",
                    "0x00000000",
                    "0x0000000000000000c8",
                    "10,000,000",
                    "3",
                    "1000",
                    ""
                ],
                "egldValue": "1,000,000,000,000,000,000",
                "gasLimit": "20,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "4",
                "message": "str:S-1: Dangerous endpoint blocked"
            }
        },
        {
            "step": "scCall",
            "id": "block-setOwner",
            "comment": "S-1b: setOwner is a dangerous endpoint — must be blocked",
            "tx": {
                "from": "address:user1",
                "to": "sc:scheduler",
                "function": "scheduleTask",
                "arguments": [
                    "address:target",
                    "str:setOwner",
                    "0x00000000",
                    "0x0000000000000000c8",
                    "10,000,000",
                    "3",
                    "1000",
                    ""
                ],
                "egldValue": "1,000,000,000,000,000,000",
                "gasLimit": "20,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "4",
                "message": "str:S-1: Dangerous endpoint blocked"
            }
        }
    ]
}