{
    "name": "expire-stale-task",
    "comment": "Test that tasks past their TTL are expired with deposit refund",
    "steps": [
        {
            "step": "setState",
            "accounts": {
                "address:owner": {
                    "nonce": "0",
                    "balance": "100,000,000,000,000,000,000"
                },
                "address:user1": {
                    "nonce": "0",
                    "balance": "50,000,000,000,000,000,000"
                },
                "address:keeper_registry": {
                    "nonce": "0",
                    "balance": "0",
                    "code": ""
                },
                "address:rewards": {
                    "nonce": "0",
                    "balance": "0",
                    "code": ""
                },
                "address:target_contract": {
                    "nonce": "0",
                    "balance": "0",
                    "code": ""
                }
            },
            "newAddresses": [
                {
                    "creatorAddress": "address:owner",
                    "creatorNonce": "0",
                    "newAddress": "sc:scheduler"
                }
            ],
            "currentBlockInfo": {
                "blockRound": "100"
            }
        },
        {
            "step": "scDeploy",
            "id": "deploy",
            "tx": {
                "from": "address:owner",
                "contractCode": "mxsc:output/scheduler.mxsc.json",
                "arguments": [
                    "address:keeper_registry",
                    "address:rewards",
                    "100,000,000,000,000,000",
                    "500"
                ],
                "gasLimit": "50,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "0"
            }
        },
        {
            "step": "scCall",
            "id": "schedule-task",
            "comment": "User1 schedules task with ttl_rounds=100, created at round 100. Trigger TimeOnce at round 150.",
            "tx": {
                "from": "address:user1",
                "to": "sc:scheduler",
                "function": "scheduleTask",
                "arguments": [
                    "address:target_contract",
                    "str:myFunction",
                    "0x00000000",
                    "0x000000000000000096",
                    "10,000,000",
                    "3",
                    "100"
                ],
                "egldValue": "1,000,000,000,000,000,000",
                "gasLimit": "20,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [
                    "1"
                ],
                "status": "0"
            }
        },
        {
            "step": "setState",
            "comment": "Advance to round 250 (past TTL of 100+100=200)",
            "currentBlockInfo": {
                "blockRound": "250"
            }
        },
        {
            "step": "scCall",
            "id": "expire-task",
            "comment": "Call expireStaleTasks with task 1 \u2014 should succeed",
            "tx": {
                "from": "address:owner",
                "to": "sc:scheduler",
                "function": "expireStaleTasks",
                "arguments": [
                    "1"
                ],
                "gasLimit": "15,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "0"
            }
        },
        {
            "step": "checkState",
            "comment": "User1 should have received the 1 EGLD refund",
            "accounts": {
                "address:user1": {
                    "balance": "50,000,000,000,000,000,000"
                }
            }
        }
    ]
}