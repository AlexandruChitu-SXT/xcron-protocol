{
    "name": "gas-too-low",
    "comment": "Verify that scheduleTask rejects max_gas below MIN_GAS_LIMIT",
    "steps": [
        {
            "step": "setState",
            "accounts": {
                "address:owner": {
                    "nonce": "0",
                    "balance": "100,000,000,000,000,000,000"
                },
                "address:user1": {
                    "nonce": "0",
                    "balance": "50,000,000,000,000,000,000"
                },
                "address:keeper_registry": {
                    "nonce": "0",
                    "balance": "0",
                    "code": ""
                },
                "address:rewards": {
                    "nonce": "0",
                    "balance": "0",
                    "code": ""
                },
                "address:target_contract": {
                    "nonce": "0",
                    "balance": "0",
                    "code": ""
                }
            },
            "newAddresses": [
                {
                    "creatorAddress": "address:owner",
                    "creatorNonce": "0",
                    "newAddress": "sc:scheduler"
                }
            ],
            "currentBlockInfo": {
                "blockRound": "100"
            }
        },
        {
            "step": "scDeploy",
            "id": "deploy",
            "tx": {
                "from": "address:owner",
                "contractCode": "mxsc:output/scheduler.mxsc.json",
                "arguments": [
                    "address:keeper_registry",
                    "address:rewards",
                    "100,000,000,000,000,000",
                    "500"
                ],
                "gasLimit": "50,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "0"
            }
        },
        {
            "step": "scCall",
            "id": "gas-too-low",
            "comment": "Schedule with max_gas=1000 (below MIN_GAS_LIMIT=5M) — should fail",
            "tx": {
                "from": "address:user1",
                "to": "sc:scheduler",
                "function": "scheduleTask",
                "arguments": [
                    "address:target_contract",
                    "str:ping",
                    "0x00000000",
                    "0x0000000000000000c8",
                    "1000",
                    "3",
                    "1000"
                ],
                "egldValue": "1,000,000,000,000,000,000",
                "gasLimit": "20,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "4",
                "message": "str:max_gas too low"
            }
        },
        {
            "step": "scCall",
            "id": "ttl-too-short",
            "comment": "Schedule with ttl_rounds=1 (below MIN_TTL_ROUNDS=10) — should fail",
            "tx": {
                "from": "address:user1",
                "to": "sc:scheduler",
                "function": "scheduleTask",
                "arguments": [
                    "address:target_contract",
                    "str:ping",
                    "0x00000000",
                    "0x0000000000000000c8",
                    "10,000,000",
                    "3",
                    "1"
                ],
                "egldValue": "1,000,000,000,000,000,000",
                "gasLimit": "20,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "4",
                "message": "str:TTL too short"
            }
        }
    ]
}