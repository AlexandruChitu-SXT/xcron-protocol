{
    "name": "clone-key-spend-limit",
    "comment": "Test that a Clone-Key cannot exceed its spend limit",
    "steps": [
        {
            "step": "setState",
            "accounts": {
                "address:owner": {
                    "nonce": "0",
                    "balance": "100,000,000,000,000,000,000"
                },
                "address:user1": {
                    "nonce": "0",
                    "balance": "10,000,000,000,000,000,000"
                },
                "address:clone1": {
                    "nonce": "0",
                    "balance": "0"
                },
                "address:keeper_registry": {
                    "nonce": "0",
                    "balance": "0",
                    "code": ""
                },
                "address:rewards": {
                    "nonce": "0",
                    "balance": "0",
                    "code": ""
                },
                "address:target_contract": {
                    "nonce": "0",
                    "balance": "0",
                    "code": ""
                }
            },
            "newAddresses": [
                {
                    "creatorAddress": "address:owner",
                    "creatorNonce": "0",
                    "newAddress": "sc:scheduler"
                }
            ],
            "currentBlockInfo": {
                "blockTimestamp": "1000",
                "blockRound": "100"
            }
        },
        {
            "step": "scDeploy",
            "id": "deploy",
            "tx": {
                "from": "address:owner",
                "contractCode": "mxsc:../output/scheduler.mxsc.json",
                "arguments": [
                    "address:keeper_registry",
                    "address:rewards",
                    "100,000,000,000,000,000",
                    "3000"
                ],
                "gasLimit": "50,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "0"
            }
        },
        {
            "step": "scCall",
            "id": "authorize-clone-key-small-limit",
            "comment": "User1 authorizes clone1 with ONLY 0.15 EGLD spend limit",
            "tx": {
                "from": "address:user1",
                "to": "sc:scheduler",
                "function": "authorizeCloneKey",
                "arguments": [
                    "address:clone1",
                    "86400"
                ],
                "egldValue": "150,000,000,000,000,000",
                "gasLimit": "10,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "0"
            }
        },
        {
            "step": "scCall",
            "id": "clone-schedules-task-1",
            "comment": "Clone-Key schedules task with 0.1 EGLD from pool (no egldValue, uses requested_deposit)",
            "tx": {
                "from": "address:clone1",
                "to": "sc:scheduler",
                "function": "scheduleQuantumTask",
                "arguments": [
                    "address:target_contract",
                    "str:myFunction",
                    "0x00000000",
                    "0x0000000000000000c8",
                    "10,000,000",
                    "3",
                    "1000",
                    "",
                    "",
                    "100,000,000,000,000,000"
                ],
                "egldValue": "0",
                "gasLimit": "20,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [
                    "1"
                ],
                "status": "0"
            }
        },
        {
            "step": "scCall",
            "id": "clone-schedules-task-2-exceeds-limit",
            "comment": "Clone-Key tries another 0.1 EGLD \u2014 should FAIL (0.1 + 0.1 = 0.2 > 0.15 limit)",
            "tx": {
                "from": "address:clone1",
                "to": "sc:scheduler",
                "function": "scheduleQuantumTask",
                "arguments": [
                    "address:target_contract",
                    "str:myFunction",
                    "0x00000000",
                    "0x00000000000000012c",
                    "10,000,000",
                    "3",
                    "1000",
                    "",
                    "",
                    "100,000,000,000,000,000"
                ],
                "egldValue": "0",
                "gasLimit": "20,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "4",
                "message": "str:Clone-Key spend limit exceeded"
            }
        }
    ]
}
