{
    "framework": "vite",
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "git": {
        "deploymentEnabled": false
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}