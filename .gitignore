contracts/target/
contracts/output/
**/wasm/target/
wasm/
output/

# ──────── NODE.JS ────────
node_modules/
dist/
.cache/

# ──────── PYTHON ────────
.venv/
__pycache__/
*.pyc

# ──────── IDE & OS ────────
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# ──────── ENVIRONMENT & SECRETS ────────
.env
.env.local
.env.*.local

# ──────── PERSONAL DATA / GRANT DOCUMENTS ────────
