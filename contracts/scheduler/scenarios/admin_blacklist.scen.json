{
    "name": "admin-blacklist",
    "comment": "S-3/S-4: Admin can blacklist and unblacklist target contracts",
    "steps": [
        {
            "step": "setState",
            "accounts": {
                "address:owner": {
                    "nonce": "0",
                    "balance": "100,000,000,000,000,000,000"
                },
                "address:user1": {
                    "nonce": "0",
                    "balance": "50,000,000,000,000,000,000"
                },
                "address:malicious": {
                    "nonce": "0",
                    "balance": "0",
                    "code": ""
                },
                "address:keeper_registry": {
                    "nonce": "0",
                    "balance": "0",
                    "code": ""
                },
                "address:rewards": {
                    "nonce": "0",
                    "balance": "0",
                    "code": ""
                }
            },
            "newAddresses": [
                {
                    "creatorAddress": "address:owner",
                    "creatorNonce": "0",
                    "newAddress": "sc:scheduler"
                }
            ]
        },
        {
            "step": "scDeploy",
            "id": "deploy",
            "tx": {
                "from": "address:owner",
                "contractCode": "mxsc:../output/scheduler.mxsc.json",
                "arguments": [
                    "address:keeper_registry",
                    "address:rewards",
                    "100,000,000,000,000,000",
                    "3000"
                ],
                "gasLimit": "50,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "0"
            }
        },
        {
            "step": "scCall",
            "id": "non-owner-blacklist-fails",
            "comment": "S-3: Only owner can blacklist \u2014 non-owner should fail",
            "tx": {
                "from": "address:user1",
                "to": "sc:scheduler",
                "function": "blacklistTarget",
                "arguments": [
                    "address:malicious"
                ],
                "gasLimit": "10,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "4",
                "message": "str:Endpoint can only be called by owner"
            }
        },
        {
            "step": "scCall",
            "id": "owner-blacklist",
            "comment": "S-3: Owner blacklists a malicious contract",
            "tx": {
                "from": "address:owner",
                "to": "sc:scheduler",
                "function": "blacklistTarget",
                "arguments": [
                    "address:malicious"
                ],
                "gasLimit": "10,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "0"
            }
        },
        {
            "step": "scCall",
            "id": "schedule-blacklisted-fails",
            "comment": "S-3: Scheduling a task targeting a blacklisted contract should fail",
            "tx": {
                "from": "address:user1",
                "to": "sc:scheduler",
                "function": "scheduleQuantumTask",
                "arguments": [
                    "address:malicious",
                    "str:doSomething",
                    "0x00000000",
                    "0x0000000000000000c8",
                    "10,000,000",
                    "3",
                    "1000",
                    "",
                    ""
                ],
                "egldValue": "1,000,000,000,000,000,000",
                "gasLimit": "20,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "4",
                "message": "str:S-1: Target contract is blacklisted"
            }
        },
        {
            "step": "scCall",
            "id": "owner-unblacklist",
            "comment": "S-4: Owner removes contract from blacklist",
            "tx": {
                "from": "address:owner",
                "to": "sc:scheduler",
                "function": "removeBlacklist",
                "arguments": [
                    "address:malicious"
                ],
                "gasLimit": "10,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "0"
            }
        }
    ]
}
