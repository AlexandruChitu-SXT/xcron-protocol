# ═══════════════════════════════════════════════════════════
#  xCron Protocol — .gitignore
# ═══════════════════════════════════════════════════════════

# ──────── SECURITY: PRIVATE KEYS & WALLETS ────────
.secrets/
wallets/
*.pem
*.keystore.json

# ──────── RUST / SMART CONTRACTS ────────
contracts/target/
contracts/output/
**/wasm/target/
wasm/
output/

# ──────── NODE.JS ────────
node_modules/
dist/
.cache/

# ──────── PYTHON ────────
.venv/
__pycache__/
*.pyc

# ──────── IDE & OS ────────
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# ──────── ENVIRONMENT & SECRETS ────────
.env
.env.local
.env.*.local

# ──────── PERSONAL DATA / GRANT DOCUMENTS ────────
*.pdf
xcron/*.pdf
xcron/*.metadata.json

# ──────── KEEPER BOT SECRETS & LOGS ────────
keeper/keeper-config.json
keeper/keeper-logs/
keeper-logs/
xportal-claim-state.json

# ──────── BUILD ARTIFACTS ────────
*.mxsc.json
contracts/*/scenarios/output/

# ──────── MISC ────────
*.log
mx-ai-skills
*.resolved
*.resolved.*
*.metadata.json
.deployed_addresses.json
.deployed_testnet.json
.agent/

# ──────── WASM BUILD ARTIFACTS ────────
*/target/
contracts/*/target/
contracts/*/wasm/target/



# ──────── KEEPER BOT (PRIVATE REPO) ────────
keeper/

# ──────── CLEANED UP — OLD/REDUNDANT ────────
xcron/
interaction/
articulos/
output/
contracts/src/
contracts/wasm/
hello_deploy.json
pong_deploy.json
set_fee.json
stress_test_output.json
tweet-*.txt
article-*.txt
estudio_economico_*.md
TARGET_CONTRACT.txt
ESTADO_Y_PLAN_MAESTRO.md
XCRON_RELEASE_NOTES_V2.md
multiversx.json
build.log
build2.log
