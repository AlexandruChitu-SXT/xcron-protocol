{
    "name": "treasury-withdraw",
    "comment": "Test owner withdrawing from protocol treasury",
    "steps": [
        {
            "step": "setState",
            "accounts": {
                "address:owner": {
                    "nonce": "0",
                    "balance": "100,000,000,000,000,000,000"
                },
                "address:keeper1": {
                    "nonce": "0",
                    "balance": "0"
                },
                "address:treasury_recipient": {
                    "nonce": "0",
                    "balance": "0"
                },
                "address:keeper_registry": {
                    "nonce": "0",
                    "balance": "0",
                    "code": ""
                }
            },
            "newAddresses": [
                {
                    "creatorAddress": "address:owner",
                    "creatorNonce": "0",
                    "newAddress": "sc:rewards"
                }
            ]
        },
        {
            "step": "scDeploy",
            "id": "deploy",
            "tx": {
                "from": "address:owner",
                "contractCode": "mxsc:../output/rewards.mxsc.json",
                "arguments": [
                    "address:keeper_registry",
                    "2000"
                ],
                "gasLimit": "50,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "0"
            }
        },
        {
            "step": "scCall",
            "id": "receive-fee",
            "comment": "Send 10 EGLD in fees — treasury gets 2 EGLD (20%)",
            "tx": {
                "from": "address:owner",
                "to": "sc:rewards",
                "function": "receiveExecutionFee",
                "arguments": [
                    "address:keeper1",
                    "1"
                ],
                "egldValue": "10,000,000,000,000,000,000",
                "gasLimit": "10,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "0"
            }
        },
        {
            "step": "scCall",
            "id": "withdraw-treasury",
            "comment": "Owner withdraws 1 EGLD from treasury to recipient",
            "tx": {
                "from": "address:owner",
                "to": "sc:rewards",
                "function": "withdrawTreasury",
                "arguments": [
                    "address:treasury_recipient",
                    "1,000,000,000,000,000,000"
                ],
                "gasLimit": "10,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "0"
            }
        },
        {
            "step": "checkState",
            "comment": "Treasury recipient should have 1 EGLD",
            "accounts": {
                "address:treasury_recipient": {
                    "balance": "1,000,000,000,000,000,000"
                }
            }
        },
        {
            "step": "scQuery",
            "id": "check-remaining-treasury",
            "comment": "Treasury should have 1 EGLD remaining (2 - 1)",
            "tx": {
                "to": "sc:rewards",
                "function": "getTreasuryBalance",
                "arguments": []
            },
            "expect": {
                "out": [
                    "1,000,000,000,000,000,000"
                ],
                "status": "0"
            }
        }
    ]
}