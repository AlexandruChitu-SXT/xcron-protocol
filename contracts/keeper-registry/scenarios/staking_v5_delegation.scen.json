{
    "name": "staking-v5-delegation",
    "comment": "Test keeper staking and subsequent delegation to a MVX Staking Provider",
    "steps": [
        {
            "step": "setState",
            "accounts": {
                "address:owner": {
                    "nonce": "0",
                    "balance": "100,000,000,000,000,000,000"
                },
                "address:keeper1": {
                    "nonce": "0",
                    "balance": "20,000,000,000,000,000,000"
                },
                "address:treasury": {
                    "nonce": "0",
                    "balance": "0"
                },
                "address:mock_provider": {
                    "nonce": "0",
                    "balance": "0"
                }
            },
            "newAddresses": [
                {
                    "creatorAddress": "address:owner",
                    "creatorNonce": "0",
                    "newAddress": "sc:keeper_registry"
                }
            ]
        },
        {
            "step": "scDeploy",
            "id": "deploy",
            "tx": {
                "from": "address:owner",
                "contractCode": "file:../output/keeper-registry.mxsc.json",
                "arguments": [
                    "5,000,000,000,000,000,000",
                    "1000",
                    "600",
                    "address:treasury"
                ],
                "gasLimit": "50,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "0"
            }
        },
        {
            "step": "scCall",
            "id": "set-staking-provider",
            "tx": {
                "from": "address:owner",
                "to": "sc:keeper_registry",
                "function": "setStakingProvider",
                "arguments": [
                    "address:mock_provider"
                ],
                "gasLimit": "10,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "0"
            }
        },
        {
            "step": "scCall",
            "id": "register-keeper",
            "tx": {
                "from": "address:keeper1",
                "to": "sc:keeper_registry",
                "function": "registerKeeper",
                "arguments": [],
                "value": "5,000,000,000,000,000,000",
                "gasLimit": "20,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "0"
            }
        },
        {
            "step": "scCall",
            "id": "delegate-stake",
            "tx": {
                "from": "address:owner",
                "to": "sc:keeper_registry",
                "function": "delegateStake",
                "arguments": [
                    "5,000,000,000,000,000,000"
                ],
                "gasLimit": "20,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "0"
            }
        },
        {
            "step": "checkState",
            "accounts": {
                "address:owner": {
                    "balance": "100,000,000,000,000,000,000"
                },
                "address:keeper1": {
                    "balance": "15,000,000,000,000,000,000"
                },
                "address:mock_provider": {
                    "balance": "5,000,000,000,000,000,000"
                }
            }
        }
    ]
}