{
    "name": "schedule-and-cancel",
    "comment": "Test scheduling a TimeOnce task and then cancelling it with full deposit refund",
    "steps": [
        {
            "step": "setState",
            "accounts": {
                "address:owner": {
                    "nonce": "0",
                    "balance": "100,000,000,000,000,000,000"
                },
                "address:user1": {
                    "nonce": "0",
                    "balance": "50,000,000,000,000,000,000"
                },
                "address:keeper_registry": {
                    "nonce": "0",
                    "balance": "0",
                    "code": ""
                },
                "address:rewards": {
                    "nonce": "0",
                    "balance": "0",
                    "code": ""
                },
                "address:target_contract": {
                    "nonce": "0",
                    "balance": "0",
                    "code": ""
                }
            },
            "newAddresses": [
                {
                    "creatorAddress": "address:owner",
                    "creatorNonce": "0",
                    "newAddress": "sc:scheduler"
                }
            ],
            "currentBlockInfo": {
                "blockRound": "100"
            }
        },
        {
            "step": "scDeploy",
            "id": "deploy",
            "comment": "Deploy Scheduler: min_deposit=0.1 EGLD, fee=500 BPS (5%)",
            "tx": {
                "from": "address:owner",
                "contractCode": "mxsc:output/scheduler.mxsc.json",
                "arguments": [
                    "address:keeper_registry",
                    "address:rewards",
                    "100,000,000,000,000,000",
                    "500"
                ],
                "gasLimit": "50,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "0"
            }
        },
        {
            "step": "scCall",
            "id": "schedule-task-1",
            "comment": "User1 schedules a TimeOnce task targeting round 200. Args: target_contract, endpoint(myFunction), target_args(empty list=0x00000000), trigger(TimeOnce disc=0x00, round=200=0xc8), max_gas=10M, max_retries=3, ttl=1000",
            "tx": {
                "from": "address:user1",
                "to": "sc:scheduler",
                "function": "scheduleTask",
                "arguments": [
                    "address:target_contract",
                    "str:myFunction",
                    "0x00000000",
                    "0x0000000000000000c8",
                    "10,000,000",
                    "3",
                    "1000"
                ],
                "egldValue": "1,000,000,000,000,000,000",
                "gasLimit": "20,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [
                    "1"
                ],
                "status": "0"
            }
        },
        {
            "step": "scQuery",
            "id": "verify-task-nonce",
            "comment": "Task nonce should now be 1",
            "tx": {
                "to": "sc:scheduler",
                "function": "getTaskNonce",
                "arguments": []
            },
            "expect": {
                "out": [
                    "1"
                ],
                "status": "0"
            }
        },
        {
            "step": "scCall",
            "id": "cancel-task-1",
            "comment": "User1 cancels task 1 and gets full deposit refund",
            "tx": {
                "from": "address:user1",
                "to": "sc:scheduler",
                "function": "cancelTask",
                "arguments": [
                    "1"
                ],
                "gasLimit": "10,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "0"
            }
        },
        {
            "step": "checkState",
            "comment": "Verify user1 got the 1 EGLD refund (balance back to original)",
            "accounts": {
                "address:user1": {
                    "balance": "50,000,000,000,000,000,000"
                }
            }
        }
    ]
}