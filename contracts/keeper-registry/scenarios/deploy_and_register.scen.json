{
    "name": "deploy-keeper-registry",
    "comment": "Test deploying the KeeperRegistry and registering a keeper",
    "steps": [
        {
            "step": "setState",
            "accounts": {
                "address:owner": {
                    "nonce": "0",
                    "balance": "100,000,000,000,000,000,000",
                    "storage": {}
                },
                "address:keeper1": {
                    "nonce": "0",
                    "balance": "10,000,000,000,000,000,000",
                    "storage": {}
                },
                "address:treasury": {
                    "nonce": "0",
                    "balance": "0",
                    "storage": {}
                }
            },
            "newAddresses": [
                {
                    "creatorAddress": "address:owner",
                    "creatorNonce": "0",
                    "newAddress": "sc:keeper_registry"
                }
            ]
        },
        {
            "step": "scDeploy",
            "id": "deploy",
            "comment": "Deploy KeeperRegistry with min_stake=1 EGLD, slash=10%, cooldown=600",
            "tx": {
                "from": "address:owner",
                "contractCode": "mxsc:output/keeper-registry.mxsc.json",
                "arguments": [
                    "1,000,000,000,000,000,000",
                    "1000",
                    "600",
                    "address:treasury"
                ],
                "gasLimit": "50,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "0"
            }
        },
        {
            "step": "scQuery",
            "id": "check-min-stake",
            "comment": "Verify min stake is 1 EGLD",
            "tx": {
                "to": "sc:keeper_registry",
                "function": "getMinStake",
                "arguments": []
            },
            "expect": {
                "out": [
                    "1,000,000,000,000,000,000"
                ],
                "status": "0"
            }
        },
        {
            "step": "scCall",
            "id": "register-keeper1",
            "comment": "Register keeper1 with 5 EGLD stake",
            "tx": {
                "from": "address:keeper1",
                "to": "sc:keeper_registry",
                "function": "registerKeeper",
                "arguments": [],
                "value": "5,000,000,000,000,000,000",
                "gasLimit": "20,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "0"
            }
        },
        {
            "step": "scQuery",
            "id": "check-active-count",
            "comment": "Verify 1 active keeper",
            "tx": {
                "to": "sc:keeper_registry",
                "function": "getActiveKeeperCount",
                "arguments": []
            },
            "expect": {
                "out": [
                    "1"
                ],
                "status": "0"
            }
        },
        {
            "step": "scQuery",
            "id": "check-keeper-active",
            "comment": "Verify keeper1 is active",
            "tx": {
                "to": "sc:keeper_registry",
                "function": "isActiveKeeper",
                "arguments": [
                    "address:keeper1"
                ]
            },
            "expect": {
                "out": [
                    "1"
                ],
                "status": "0"
            }
        }
    ]
}